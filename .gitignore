# ============================================
# Python Bytecode & Cache
# ============================================
__pycache__/
*.pyc          # Compiled Python files (e.g., inverted_index.cpython-311.pyc)
*.pyo          # Optimized compiled files
*.pyd          # Python DLL files

# ============================================
# Virtual Environment
# ============================================
venv/
.venv/
env/
.env/

# ============================================
# Environment Variables & Secrets
# ============================================
.env
.env.*
*.env

# ============================================
# Databases & SQLite
# ============================================
*.db
*.sqlite
*.sqlite3

# ============================================
# IDE / Editor Configurations
# ============================================
.idea/         # JetBrains (PyCharm)
.vscode/       # Visual Studio Code
*.swp
*.swo
*~

# ============================================
# Serialized Objects & Index Files
# Covers: inverted_index.pkl, bert_vector_store.faiss, etc.
# ============================================
*.pkl
*.pickle
*.faiss

# ============================================
# Raw & Processed Data Files (CSV)
# Covers: processed_docs.csv, processed_docs_10k.csv, etc.
# ============================================
*.csv

# ============================================
# Project Data Directories (BEST PRACTICE)
# This single rule recursively ignores ALL files inside:
#   - data/index/bert_vector_store.faiss
#   - data/index/inverted_index.pkl
#   - data/processed/processed_docs.csv
#   - data/processed/processed_docs_10k.csv
# ============================================
data/

# ============================================
# Explicit Service Cache Directories
# (Already covered by __pycache__/ above, but added for extra clarity)
# ============================================
services/indexing/__pycache__/
services/preprocessing/__pycache__/
services/query_processing/__pycache__/

# ============================================
# Optional: Keep empty directories in version control
# Uncomment the lines below if you want Git to keep the folder
# structure for data/ while ignoring the files inside.
# ============================================
# !data/index/.gitkeep
# !data/processed/.gitkeep